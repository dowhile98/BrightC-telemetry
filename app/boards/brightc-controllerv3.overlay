/ {
	aliases {
		modbus-uart-1 = &usart2;
		modbus-uart-2 = &usart6;
		modbus-rtu-1 = &modbusRTU0;
		modbus-rtu-2 = &modbusRTU1;
		rtc = &rtc;
	};
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB4, 16)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	async-prescaler = <127>;
	sync-prescaler = <255>;
	status = "okay";
};
&usart2_rx_pd6 {
	bias-pull-up;
};

&usart2 {
	/*default baud rate */
	current-speed = <9600>;
	/*default de-assert time */
	de-assert-time = <1>;
	/*default de-deassert time */
	de-deassert-time = <16>;

	/*nanomodbus*/
	modbusRTU0: modbusRTU0 {
		compatible = "nanomodbus,serial";
		status = "okay";
		de-mode = "hardware";
		rx-mode = "irq";
	};
};

&usart6 {
	/*default baud rate */
	current-speed = <9600>;
	/*default de-assert time */
	de-assert-time = <1>;
	/*default de-deassert time */
	de-deassert-time = <16>;

	/*nanomodbus*/
	modbusRTU1: modbusRTU1 {
		compatible = "nanomodbus,serial";
		status = "okay";
		de-mode = "hardware";
		rx-mode = "irq";
	};
};
