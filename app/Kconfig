# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"

config APP_MODBUS_BUS_PROBE
	bool "Modbus bring-up diagnostic"
	depends on NANOMODBUS
	default n
	help
	  Sweep the Modbus slave addresses and the energy-meter register window
	  once at boot, before the polling threads claim the bus, and log every
	  outcome. It separates an addressing problem from a register-map one on
	  a slave that answers nothing. Diagnostic builds only: it costs one
	  transaction per probe and delays startup.

config APP_MODBUS_INTER_POLL_DELAY_MS
	int "Inter-poll turnaround delay in milliseconds"
	default 40
	range 0 1000
	help
	  Turnaround delay between consecutive Modbus transactions on the same
	  RS-485 bus. Gives slave transceivers time to release the bus and
	  satisfies the Modbus RTU inter-frame silence interval (t3.5+).

menu "BrightC Network Configuration"

config BRIGHTC_WIFI_DEFAULT_SSID
	string "Default Wi-Fi Soft-AP SSID"
	default "BrightC-AP"
	help
	  Default SSID broadcasted by the soft-AP interface.

config BRIGHTC_WIFI_DEFAULT_PSK
	string "Default Wi-Fi Soft-AP Pre-Shared Key (PSK)"
	default "12345678"
	help
	  Default WPA2 pre-shared key for the soft-AP interface.

config BRIGHTC_WIFI_DEFAULT_IP
	hex "Default Wi-Fi Soft-AP IPv4 Address"
	default 0xC0A80401
	help
	  Default IPv4 address of the soft-AP (0xC0A80401 = 192.168.4.1).

endmenu

menu "BrightC Modbus Configuration"

config BRIGHTC_DEFAULT_MODBUS_ADDR_MBSL32DI
	int "Default Modbus slave address for MBSL32DI digital input"
	default 3
	range 1 247
	help
	  Default RTU slave address for 32-channel digital input module.

config BRIGHTC_DEFAULT_MODBUS_ADDR_WAVESHARE_RELAY
	int "Default Modbus slave address for Waveshare 32CH relay"
	default 4
	range 1 247
	help
	  Default RTU slave address for Waveshare 32-channel Modbus relay module.

endmenu

