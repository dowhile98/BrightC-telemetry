menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"

config APP_MODBUS_BUS_PROBE
	bool "Modbus bring-up diagnostic"
	depends on NANOMODBUS
	default n
	help
	  Sweep the Modbus slave addresses and the energy-meter register window
	  once at boot, before the polling threads claim the bus, and log every
	  outcome. It separates an addressing problem from a register-map one on
	  a slave that answers nothing. Diagnostic builds only: it costs one
	  transaction per probe and delays startup.

config APP_MODBUS_INTER_POLL_DELAY_MS
	int "Inter-poll turnaround delay in milliseconds"
	default 40
	range 0 1000
	help
	  Turnaround delay between consecutive Modbus transactions on the same
	  RS-485 bus. Gives slave transceivers time to release the bus and
	  satisfies the Modbus RTU inter-frame silence interval (t3.5+).

menu "BrightC Network Configuration"

config BRIGHTC_WIFI_DEFAULT_SSID
	string "Default Wi-Fi Soft-AP SSID"
	default "BrightC-AP"
	help
	  Default SSID broadcasted by the soft-AP interface.

config BRIGHTC_WIFI_DEFAULT_PSK
	string "Default Wi-Fi Soft-AP Pre-Shared Key (PSK)"
	default "12345678"
	help
	  Default WPA2 pre-shared key for the soft-AP interface.

config BRIGHTC_WIFI_DEFAULT_IP
	hex "Default Wi-Fi Soft-AP IPv4 Address"
	default 0xC0A80401
	help
	  Default IPv4 address of the soft-AP (0xC0A80401 = 192.168.4.1).

endmenu

menu "BrightC Modbus Configuration"

config BRIGHTC_MODBUS_KCONFIG_PRESENT
	bool
	default y

# --- 1. JSY-MK-339 (Enabled by default) ---
menuconfig BRIGHTC_MODBUS_ENABLE_JSY_MK339
	bool "JSY-MK-339 3-Phase AC Energy Meter"
	default y
	help
	  Enable Modbus RTU polling for JSY-MK-339 3-Phase AC energy meter on RS485-1.

if BRIGHTC_MODBUS_ENABLE_JSY_MK339

config BRIGHTC_MODBUS_ADDR_JSY_MK339
	int "Modbus slave address for JSY-MK-339"
	default 2
	range 1 247
	help
	  RTU slave address (1..247).

endif # BRIGHTC_MODBUS_ENABLE_JSY_MK339

# --- 2. CWT-TM-16PT Concentrator 1 (Disabled by default) ---
menuconfig BRIGHTC_MODBUS_ENABLE_CWT_TM16PT_1
	bool "CWT-TM-16PT 16-channel PT100 Concentrator 1"
	default y
	help
	  Enable Modbus RTU polling for primary 16-channel PT100 concentrator on RS485-1.

if BRIGHTC_MODBUS_ENABLE_CWT_TM16PT_1

config BRIGHTC_MODBUS_ADDR_CWT_TM16PT_1
	int "Modbus slave address for CWT-TM-16PT #1"
	default 1
	range 1 247

endif # BRIGHTC_MODBUS_ENABLE_CWT_TM16PT_1

# --- 3. CWT-TM-16PT Concentrator 2 (Disabled by default) ---
menuconfig BRIGHTC_MODBUS_ENABLE_CWT_TM16PT_2
	bool "CWT-TM-16PT 16-channel PT100 Concentrator 2"
	default n
	help
	  Enable Modbus RTU polling for secondary 16-channel PT100 concentrator on RS485-1.

if BRIGHTC_MODBUS_ENABLE_CWT_TM16PT_2

config BRIGHTC_MODBUS_ADDR_CWT_TM16PT_2
	int "Modbus slave address for CWT-TM-16PT #2"
	default 3
	range 1 247

endif # BRIGHTC_MODBUS_ENABLE_CWT_TM16PT_2

# --- 4. MBSL32DI Digital Inputs (Disabled by default) ---
menuconfig BRIGHTC_MODBUS_ENABLE_MBSL32DI
	bool "MBSL32DI 32-channel Digital Input Expander"
	default y
	help
	  Enable Modbus RTU polling for 32-channel digital input module on RS485-2.

if BRIGHTC_MODBUS_ENABLE_MBSL32DI

config BRIGHTC_MODBUS_ADDR_MBSL32DI
	int "Modbus slave address for MBSL32DI"
	default 3
	range 1 247

endif # BRIGHTC_MODBUS_ENABLE_MBSL32DI

# --- 5. Waveshare Relay Expander (Disabled by default) ---
menuconfig BRIGHTC_MODBUS_ENABLE_WAVESHARE_RELAY
	bool "Waveshare 32-channel Modbus Relay Expander"
	default y
	help
	  Enable Modbus RTU control for Waveshare 32-channel relay module on RS485-2.

if BRIGHTC_MODBUS_ENABLE_WAVESHARE_RELAY

config BRIGHTC_MODBUS_ADDR_WAVESHARE_RELAY
	int "Modbus slave address for Waveshare Relay"
	default 4
	range 1 247

endif # BRIGHTC_MODBUS_ENABLE_WAVESHARE_RELAY

endmenu


menu "BrightC Alarm Management Subsystem"

config ALARM_MANAGER_MAX_ALARMS
	int "Maximum tracked alarms in catalog"
	default 80
	range 32 256
	help
	  Maximum number of discrete and aggregated alarm descriptors and live
	  entities supported by the central alarm manager.

config AO_ALARM_MANAGER_QUEUE_DEPTH
	int "Active Object message queue depth"
	default 64
	range 16 256
	help
	  Capacity of the asynchronous condition event queue for ao_alarm_manager.

config AO_ALARM_MANAGER_STACK_SIZE
	int "Alarm Manager thread stack size"
	default 2048
	range 1024 8192
	help
	  Stack storage size allocated for the ao_alarm_manager thread.

endmenu

menu "BrightC Thermal and Energy Subsystem"

config THERMAL_HOURLY_PAIRS_COUNT
	int "Configured supply/return thermal pairs in hourly log"
	default 6
	range 1 16
	help
	  Number of supply/return temperature probe pairs stored per hourly
	  compressed record in datalogger storage.

config THERMAL_HOURLY_ROOM_PROBES_COUNT
	int "Configured room ambient probes in hourly log"
	default 2
	range 1 16
	help
	  Number of room ambient temperature probes stored per hourly
	  compressed record in datalogger storage.

config THERMAL_HOURLY_OUTDOOR_PROBES_COUNT
	int "Configured outdoor reference probes in hourly log"
	default 2
	range 1 8
	help
	  Number of outdoor ambient condenser reference probes stored per hourly
	  compressed record in datalogger storage.

endmenu

