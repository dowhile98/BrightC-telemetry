# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"

config APP_MODBUS_BUS_PROBE
	bool "Modbus bring-up diagnostic"
	depends on NANOMODBUS
	default n
	help
	  Sweep the Modbus slave addresses and the energy-meter register window
	  once at boot, before the polling threads claim the bus, and log every
	  outcome. It separates an addressing problem from a register-map one on
	  a slave that answers nothing. Diagnostic builds only: it costs one
	  transaction per probe and delays startup.

config APP_MODBUS_INTER_POLL_DELAY_MS
	int "Inter-poll turnaround delay in milliseconds"
	default 40
	range 0 1000
	help
	  Turnaround delay between consecutive Modbus transactions on the same
	  RS-485 bus. Gives slave transceivers time to release the bus and
	  satisfies the Modbus RTU inter-frame silence interval (t3.5+).

menu "BrightC Network Configuration"

config BRIGHTC_WIFI_DEFAULT_SSID
	string "Default Wi-Fi Soft-AP SSID"
	default "BrightC-AP"
	help
	  Default SSID broadcasted by the soft-AP interface.

config BRIGHTC_WIFI_DEFAULT_PSK
	string "Default Wi-Fi Soft-AP Pre-Shared Key (PSK)"
	default "12345678"
	help
	  Default WPA2 pre-shared key for the soft-AP interface.

config BRIGHTC_WIFI_DEFAULT_IP
	hex "Default Wi-Fi Soft-AP IPv4 Address"
	default 0xC0A80401
	help
	  Default IPv4 address of the soft-AP (0xC0A80401 = 192.168.4.1).

endmenu

rsource "Kconfig.modbus"


menu "BrightC Alarm Management Subsystem"

config ALARM_MANAGER_MAX_ALARMS
	int "Maximum tracked alarms in catalog"
	default 80
	range 32 256
	help
	  Maximum number of discrete and aggregated alarm descriptors and live
	  entities supported by the central alarm manager.

config AO_ALARM_MANAGER_QUEUE_DEPTH
	int "Active Object message queue depth"
	default 64
	range 16 256
	help
	  Capacity of the asynchronous condition event queue for ao_alarm_manager.

config AO_ALARM_MANAGER_STACK_SIZE
	int "Alarm Manager thread stack size"
	default 2048
	range 1024 8192
	help
	  Stack storage size allocated for the ao_alarm_manager thread.

endmenu

menu "BrightC Thermal and Energy Subsystem"

config THERMAL_HOURLY_PAIRS_COUNT
	int "Configured supply/return thermal pairs in hourly log"
	default 6
	range 1 16
	help
	  Number of supply/return temperature probe pairs stored per hourly
	  compressed record in datalogger storage.

config THERMAL_HOURLY_ROOM_PROBES_COUNT
	int "Configured room ambient probes in hourly log"
	default 2
	range 1 16
	help
	  Number of room ambient temperature probes stored per hourly
	  compressed record in datalogger storage.

config THERMAL_HOURLY_OUTDOOR_PROBES_COUNT
	int "Configured outdoor reference probes in hourly log"
	default 2
	range 1 8
	help
	  Number of outdoor ambient condenser reference probes stored per hourly
	  compressed record in datalogger storage.

endmenu

menu "BrightC Historical Datalogger & Event Logging Subsystem"

config DATALOGGER_BUFFER_SIZE
	int "Datalogger sector staging buffer size in bytes"
	default 512
	range 256 4096
	help
	  Size of sector-aligned RAM staging buffer allocated per active stream.

config DATALOGGER_FLUSH_INTERVAL_MS
	int "Datalogger inactivity hold-off flush timeout in milliseconds"
	default 5000
	range 1000 60000
	help
	  Duration of inactivity before staging buffers are automatically flushed.

endmenu


