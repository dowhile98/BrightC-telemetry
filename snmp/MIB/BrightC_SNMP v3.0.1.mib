-- ************************************* HVAC DATA NOTIFICAION ***************************************************
brightCv3KeyHVACTable OBJECT-TYPE
    SYNTAX SEQUENCE OF BrightCv3KeyHVACEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
    "HVAC data table"
    ::= { brightCv3HVAC 1 }

brightCv3KeyHVACEntry OBJECT-TYPE
    SYNTAX BrightCv3KeyHVACEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
    "Key HVAC Entry"
    INDEX { keyHVACKeyID }
    ::= { brightCv3KeyHVACTable 1 }

BrightCv3KeyHVACEntry ::= SEQUENCE {
    keyHVACKeyID Integer32
}

keyHVACKeyID OBJECT-TYPE
    SYNTAX Integer32 (1..2147483647)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
    "HVAC Key ID"
    ::= { brightCv3KeyHVACEntry 1 }

brightCv3HvacGroupTable OBJECT-TYPE
    SYNTAX SEQUENCE OF BrightCv3HvacGroupEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
        "Table of HVAC thermal coordination groups controlling AC sequencing."
    ::= { brightCv3HVAC 2 }

brightCv3HvacGroupEntry OBJECT-TYPE
    SYNTAX BrightCv3HvacGroupEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "Entry for an HVAC thermal coordination group (Sala 1..4)"
    INDEX { hvacGroupIndex }
    ::= { brightCv3HvacGroupTable 1 }

BrightCv3HvacGroupEntry ::= SEQUENCE {
    hvacGroupIndex          Integer32,
    hvacGroupName           OCTET STRING,
    hvacGroupState          INTEGER,
    hvacGroupControlTemp    TempDegreesDiv10,
    hvacGroupTempMin        TempDegreesDiv10,
    hvacGroupTempMax        TempDegreesDiv10,
    hvacGroupTempAlarm      TempDegreesDiv10,
    hvacGroupTempBypass     TempDegreesDiv10,
    hvacGroupValidSensors   Integer32,
    hvacGroupActiveUnits    Integer32
}

hvacGroupIndex OBJECT-TYPE
    SYNTAX Integer32 (1..4)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "HVAC Group index (1..4)"
    ::= { brightCv3HvacGroupEntry 1 }

hvacGroupName OBJECT-TYPE
    SYNTAX OCTET STRING (SIZE (0..32))
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Descriptive name of the HVAC group or zone (e.g., Sala 1)"
    ::= { brightCv3HvacGroupEntry 2 }

hvacGroupState OBJECT-TYPE
    SYNTAX INTEGER {
        idle(1),
        off(2),
        cooling(3),
        coolBoost(4),
        bypass(5),
        fire(6),
        manual(7)
    }
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Operational state of the HVAC coordination group"
    ::= { brightCv3HvacGroupEntry 3 }

hvacGroupControlTemp OBJECT-TYPE
    SYNTAX TempDegreesDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Active control temperature driving AC unit sequencing in tenths of deg C"
    ::= { brightCv3HvacGroupEntry 4 }

hvacGroupTempMin OBJECT-TYPE
    SYNTAX TempDegreesDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Low temperature setpoint where cooling stops in tenths of deg C"
    ::= { brightCv3HvacGroupEntry 5 }

hvacGroupTempMax OBJECT-TYPE
    SYNTAX TempDegreesDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "High temperature setpoint where cooling starts in tenths of deg C"
    ::= { brightCv3HvacGroupEntry 6 }

hvacGroupTempAlarm OBJECT-TYPE
    SYNTAX TempDegreesDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Boost setpoint where all reserve units start in tenths of deg C"
    ::= { brightCv3HvacGroupEntry 7 }

hvacGroupTempBypass OBJECT-TYPE
    SYNTAX TempDegreesDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Critical setpoint where mechanical bypass trips in tenths of deg C"
    ::= { brightCv3HvacGroupEntry 8 }

hvacGroupValidSensors OBJECT-TYPE
    SYNTAX Integer32 (0..16)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Number of healthy temperature sensor probes reporting in this group"
    ::= { brightCv3HvacGroupEntry 9 }

hvacGroupActiveUnits OBJECT-TYPE
    SYNTAX Integer32 (0..8)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Number of AC units actively running in turn for this group"
    ::= { brightCv3HvacGroupEntry 10 }

-- ************************************* ALARMS DATA NOTIFICAION ***************************************************
brightCv3KeyAlarmsTable OBJECT-TYPE
    SYNTAX SEQUENCE OF BrightCv3KeyAlarmsEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
    "Alarms data table"
    ::= { brightCv3Alarms 1 }

brightCv3KeyAlarmsEntry OBJECT-TYPE
    SYNTAX BrightCv3KeyAlarmsEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
    "Key Alarms Entry"
    INDEX { keyAlarmsKeyID }
    ::= { brightCv3KeyAlarmsTable 1 }

BrightCv3KeyAlarmsEntry ::= SEQUENCE {
    keyAlarmsKeyID Integer32
}

keyAlarmsKeyID OBJECT-TYPE
    SYNTAX Integer32 (1..2147483647)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
    "Alarms Key ID"
    ::= { brightCv3KeyAlarmsEntry 1 }
-- ************************************* CONFIG DATA NOTIFICAION ***************************************************
brightCv3KeyConfigTable OBJECT-TYPE
    SYNTAX SEQUENCE OF BrightCv3KeyConfigEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
    "Config data table"
    ::= { brightCv3Config 1 }

brightCv3KeyConfigEntry OBJECT-TYPE
    SYNTAX BrightCv3KeyConfigEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
    "Key Config Entry"
    INDEX { keyConfigKeyID }
    ::= { brightCv3KeyConfigTable 1 }

BrightCv3KeyConfigEntry ::= SEQUENCE {
    keyConfigKeyID Integer32
}

keyConfigKeyID OBJECT-TYPE
    SYNTAX Integer32 (1..2147483647)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
    "Config Key ID"
    ::= { brightCv3KeyConfigEntry 1 }

-- ************************************* ENERGY METER TELEMETRY ****************************************************
energyCommStatus OBJECT-TYPE
    SYNTAX INTEGER {
        ok(1),
        commFault(2),
        unconfigured(3)
    }
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Communication status with JSY-MK-339 energy meter"
    ::= { brightCv3Energy 1 }

energyLineFrequency OBJECT-TYPE
    SYNTAX FrequencyDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "AC line frequency in tenths of Hz (e.g. 600 = 60.0 Hz)"
    ::= { brightCv3Energy 2 }

voltagePhaseA OBJECT-TYPE
    SYNTAX ElectricalPotentialDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase A RMS voltage in tenths of Volt (e.g. 2205 = 220.5 V)"
    ::= { brightCv3Energy 3 }

voltagePhaseB OBJECT-TYPE
    SYNTAX ElectricalPotentialDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase B RMS voltage in tenths of Volt"
    ::= { brightCv3Energy 4 }

voltagePhaseC OBJECT-TYPE
    SYNTAX ElectricalPotentialDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase C RMS voltage in tenths of Volt"
    ::= { brightCv3Energy 5 }

currentPhaseA OBJECT-TYPE
    SYNTAX CurrentDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase A RMS current in tenths of Ampere (e.g. 152 = 15.2 A)"
    ::= { brightCv3Energy 6 }

currentPhaseB OBJECT-TYPE
    SYNTAX CurrentDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase B RMS current in tenths of Ampere"
    ::= { brightCv3Energy 7 }

currentPhaseC OBJECT-TYPE
    SYNTAX CurrentDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase C RMS current in tenths of Ampere"
    ::= { brightCv3Energy 8 }

leakageCurrent OBJECT-TYPE
    SYNTAX CurrentDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Residual leakage current in tenths of Ampere"
    ::= { brightCv3Energy 9 }

activePowerPhaseA OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase A active power in Watts"
    ::= { brightCv3Energy 10 }

activePowerPhaseB OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase B active power in Watts"
    ::= { brightCv3Energy 11 }

activePowerPhaseC OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase C active power in Watts"
    ::= { brightCv3Energy 12 }

totalActivePower OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Total active power P_total in Watts"
    ::= { brightCv3Energy 13 }

totalReactivePower OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Total reactive power Q_total in VAr"
    ::= { brightCv3Energy 14 }

totalApparentPower OBJECT-TYPE
    SYNTAX Integer32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Total apparent power S_total in VA"
    ::= { brightCv3Energy 15 }

powerFactorPhaseA OBJECT-TYPE
    SYNTAX PowerFactorDiv100
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase A power factor (-100 to 100, e.g. 95 = 0.95)"
    ::= { brightCv3Energy 16 }

powerFactorPhaseB OBJECT-TYPE
    SYNTAX PowerFactorDiv100
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase B power factor (-100 to 100)"
    ::= { brightCv3Energy 17 }

powerFactorPhaseC OBJECT-TYPE
    SYNTAX PowerFactorDiv100
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Phase C power factor (-100 to 100)"
    ::= { brightCv3Energy 18 }

totalPowerFactor OBJECT-TYPE
    SYNTAX PowerFactorDiv100
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Total 3-phase power factor (-100 to 100)"
    ::= { brightCv3Energy 19 }

totalActiveEnergyKwh OBJECT-TYPE
    SYNTAX Unsigned32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Accumulated total active energy in kWh"
    ::= { brightCv3Energy 20 }

totalReactiveEnergyKvarh OBJECT-TYPE
    SYNTAX Unsigned32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "Accumulated total reactive energy in kvarh"
    ::= { brightCv3Energy 21 }
    
-- ************************************* TRAP/NOTIFICATION MANAGEMENT SECTION *************************************


brightCAlarmStateTable OBJECT-TYPE
    SYNTAX          SEQUENCE OF BrightCxxAlarmStateEntry
    MAX-ACCESS      not-accessible
    STATUS          current
    DESCRIPTION
    "Alarms state table"
    ::={brightCTrapsMngr  1}

BrightCxxAlarmStateEntry ::= SEQUENCE {
    brightCxxAlarmKeyID     Integer32,
    brightCxxTrapID         Integer32,
    brightCxxTrapState      INTEGER,
    brightCxxTrapTimeStamp  TimeTicks,
    brightCxxTrapDsc        OCTET STRING
}

brightCxxAlarmStateEntry OBJECT-TYPE
    SYNTAX      BrightCxxAlarmStateEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "Entry in the alarms state table,
        indexed by Key ID (1..100)"
    INDEX
        { brightCxxAlarmKeyID }
    ::= { brightCAlarmStateTable 1 }

brightCxxAlarmKeyID OBJECT-TYPE
    SYNTAX  Integer32 (1..100)
    MAX-ACCESS  not-accessible
    STATUS  current
    DESCRIPTION "Notification Key ID"
        ::= { brightCxxAlarmStateEntry 1 }

brightCxxTrapID OBJECT-TYPE
    SYNTAX      Integer32 (0..100)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Alarm identification number"
    ::= { brightCxxAlarmStateEntry 2 }

brightCxxTrapState OBJECT-TYPE
    SYNTAX      INTEGER {
                alarmDisable(1),
                alarmEnable(2)
            }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Alarm state. Trap 'alarmDisable' clears former alarms."
    ::= { brightCxxAlarmStateEntry 3 }

brightCxxTrapTimeStamp OBJECT-TYPE
    SYNTAX      TimeTicks
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Trap timestamp in UNIX format - seconds since Jan 01 1970. (UTC)."
    ::= { brightCxxAlarmStateEntry 4 }

brightCxxTrapDsc    OBJECT-TYPE
    SYNTAX          OCTET STRING (SIZE (0..64))
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION
        "Trap description"
    ::= { brightCxxAlarmStateEntry 5 }

alarmSummaryActiveCount OBJECT-TYPE
    SYNTAX          Gauge32
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION
        "Number of currently active plant alarms reported in summary notifications."
    ::= { brightCTrapsMngr 2 }

alarmSummaryActiveMask OBJECT-TYPE
    SYNTAX          OCTET STRING (SIZE (12))
    MAX-ACCESS      read-only
    STATUS          current
    DESCRIPTION
        "12-byte (96-bit) bitmask of active alarms indexed by alarm ID (1..96)."
    ::= { brightCTrapsMngr 3 }



