brightCv3Compliance MODULE-COMPLIANCE
    STATUS current
    DESCRIPTION
        "The compliance statement for SNMP entities implementing BRIGHTCv3 MIB."
    MODULE -- this module
        MANDATORY-GROUPS {
            brightCv3SensorGroup,
