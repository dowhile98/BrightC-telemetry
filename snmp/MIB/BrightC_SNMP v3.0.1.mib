--
-- BrightC_SNMP v3.0.0.mib
--
--
-- REVISION HISTORY
--
--Bright-C_MIB { iso(1) org(3) dod(6) internet(1) private(4) enterprises(1) daecge(3134) daecgeProduct(1) }
BRIGHTCv3-v1-0-MIB DEFINITIONS ::= BEGIN

IMPORTS
    OBJECT-TYPE, NOTIFICATION-TYPE, MODULE-IDENTITY,
    Integer32, Unsigned32, Gauge32, enterprises, TimeTicks
        FROM SNMPv2-SMI
    TEXTUAL-CONVENTION
        FROM SNMPv2-TC
    MODULE-COMPLIANCE, OBJECT-GROUP, NOTIFICATION-GROUP
        FROM SNMPv2-CONF;

daecge MODULE-IDENTITY
    LAST-UPDATED "202611160000Z"
    ORGANIZATION "CORPORACION DAECGE S.A.C"
    CONTACT-INFO    
        "CORPORACION DAECGE S.A.C contact info:
        post:  Parinuahuanca 875 Urb. 
            Parque Naranjal II Etapa, 
            Los Olivos - Lima, Peru 
        Telf:       +51 960 326 513
        email:      emilce.meza@daecge.net"
		
    DESCRIPTION
        "v3.0.1 MIB file for the BRIGHTCv3 industrial telemetry and control module"
    REVISION "202611160000Z"
    DESCRIPTION
        "Expanded temperature sensor matrix and 3-phase AC energy meter telemetry objects"
    REVISION "202401270000Z"
    DESCRIPTION
        "Updated for BRIGHTC v3.0 traps"

    ::={enterprises 3134}

-- ************************************* Product ***************************************
brightC              OBJECT IDENTIFIER ::= { daecge 2 }
brightCv3            OBJECT IDENTIFIER ::= { brightC 3 }
brightCv3Traps       OBJECT IDENTIFIER ::= { brightCv3 0 }
brightCv3Control     OBJECT IDENTIFIER ::= { brightCv3 1 }
brightCv3Sensor      OBJECT IDENTIFIER ::= { brightCv3 2 }
brightCv3HVAC        OBJECT IDENTIFIER ::= { brightCv3 3 }
brightCv3Alarms      OBJECT IDENTIFIER ::= { brightCv3 4 }
brightCv3Config      OBJECT IDENTIFIER ::= { brightCv3 5 }
brightCv3Energy      OBJECT IDENTIFIER ::= { brightCv3 6 }
brightCTrapsMngr     OBJECT IDENTIFIER ::= { brightCv3 150 }
brightCv3Conformance OBJECT IDENTIFIER ::= { brightCv3 200 }
-- ************************************* Instrumentation Section ***********************

-- ************************************* TEXTUAL CONVENTIONS ***************************
TempDegreesDiv10    ::= TEXTUAL-CONVENTION
    DISPLAY-HINT    "d-1"
    STATUS          current
    DESCRIPTION     "Temperature degrees celcius. Fixed point, one decimal"
    SYNTAX          Integer32(-500..1500)

CurrentDiv10 ::= TEXTUAL-CONVENTION
    DISPLAY-HINT "d-1"
    STATUS       current
    DESCRIPTION  "Current. Fixed point, one decimal"
    SYNTAX       Unsigned32 (0..99999)

ElectricalPotentialDiv10 ::= TEXTUAL-CONVENTION
    DISPLAY-HINT "d-1"
    STATUS       current
    DESCRIPTION  "Electrical potential. Fixed point, one decimal"
    SYNTAX       Unsigned32 (0..10000)

PowerFactorDiv100 ::= TEXTUAL-CONVENTION
    DISPLAY-HINT "d-2"
    STATUS       current
    DESCRIPTION  "Power factor. Fixed point, two decimals"
    SYNTAX       Integer32 (-100..100)

FrequencyDiv10 ::= TEXTUAL-CONVENTION
    DISPLAY-HINT "d-1"
    STATUS       current
    DESCRIPTION  "AC line frequency in Hz. Fixed point, one decimal"
    SYNTAX       Unsigned32 (0..1000)	

-- ************************************* CONTROL DATA DEFINITION **************************************************
brightCv3KeyControlTable OBJECT-TYPE
    SYNTAX SEQUENCE OF BrightCv3KeyControlEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
    "Control data table"
    ::= { brightCv3Control 1 }

brightCv3KeyControlEntry OBJECT-TYPE
    SYNTAX BrightCv3KeyControlEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
    "Key Control Entry"
    INDEX { keyControlKeyID }
    ::= { brightCv3KeyControlTable 1 }

BrightCv3KeyControlEntry ::= SEQUENCE {
    keyControlKeyID Integer32
}

keyControlKeyID OBJECT-TYPE
    SYNTAX Integer32 (1..2147483647)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
    "Control Key ID"
    ::= { brightCv3KeyControlEntry 1 }

-- ************************************* SENSOR DATA NOTIFICAION ***************************************************
brightCv3KeySensorTable OBJECT-TYPE
    SYNTAX SEQUENCE OF BrightCv3KeySensorEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION 
    "Sensor channels telemetry table"
    ::= { brightCv3Sensor 1 }

brightCv3KeySensorEntry OBJECT-TYPE
    SYNTAX BrightCv3KeySensorEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
    "Physical sensor channel entry"
    INDEX { keySensorKeyID }
    ::= { brightCv3KeySensorTable 1 }

BrightCv3KeySensorEntry ::= SEQUENCE {
    keySensorKeyID          Integer32,
    sensorName              OCTET STRING,
    sensorPhysicalChannel   Integer32,
    sensorRole              INTEGER,
    sensorTemperature       TempDegreesDiv10,
    sensorStatus            INTEGER
}

keySensorKeyID OBJECT-TYPE
    SYNTAX Integer32 (1..64)
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
    "Sequential sensor entry index (1..64)"
    ::= { brightCv3KeySensorEntry 1 }

sensorName OBJECT-TYPE
    SYNTAX OCTET STRING (SIZE (0..32))
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
    "Sensor descriptive name (e.g., CWT1_CH01, SupplyAir_1)"
    ::= { brightCv3KeySensorEntry 2 }

sensorPhysicalChannel OBJECT-TYPE
    SYNTAX Integer32 (0..79)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
    "Underlying physical hardware channel identifier"
    ::= { brightCv3KeySensorEntry 3 }

sensorRole OBJECT-TYPE
    SYNTAX INTEGER {
        unassigned(1),
        supplyAir(2),
        returnAir(3),
        roomAmbient(4),
        outdoorAmbient(5),
        humidityReturn(6)
    }
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
    "Semantic role mapped in the thermal matrix"
    ::= { brightCv3KeySensorEntry 4 }

sensorTemperature OBJECT-TYPE
    SYNTAX TempDegreesDiv10
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
    "Calibrated temperature in tenths of degrees Celsius (e.g. 245 = 24.5 C)"
    ::= { brightCv3KeySensorEntry 5 }

sensorStatus OBJECT-TYPE
    SYNTAX INTEGER {
        normal(1),
        openProbe(2),
        shortCircuit(3),
        commFault(4),
        disabled(5)
    }
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
    "Sensor hardware probe health and communication status"
    ::= { brightCv3KeySensorEntry 6 }

-- ************************************* PROCESS TEMPERATURES ******************************************************
brightCv3SemanticTemps OBJECT IDENTIFIER ::= { brightCv3Sensor 2 }

tempSupplyEvap1 OBJECT-TYPE
