-- ************************************* CONFORMANCE DEFINITIONS *************************************
brightCv3Compliances OBJECT IDENTIFIER ::= { brightCv3Conformance 1 }
brightCv3Groups      OBJECT IDENTIFIER ::= { brightCv3Conformance 2 }

brightCv3SensorGroup OBJECT-GROUP
    OBJECTS {
        sensorName,
        sensorPhysicalChannel,
        sensorRole,
        sensorTemperature,
        sensorStatus
    }
    STATUS current
    DESCRIPTION
        "Physical sensor channels telemetry objects."
    ::= { brightCv3Groups 1 }

brightCv3SemanticTempsGroup OBJECT-GROUP
    OBJECTS {
        tempSupplyEvap1,
        tempReturnEvap1,
        tempDeltaEvap1,
        tempSupplyEvap2,
        tempReturnEvap2,
        tempDeltaEvap2,
        tempSupplyEvap3,
        tempReturnEvap3,
        tempDeltaEvap3,
        tempSupplyEvap4,
        tempReturnEvap4,
        tempDeltaEvap4,
        tempRoomAmbient1,
        tempRoomAmbient2,
        tempOutdoorAmbient1,
        humidityReturnGrille,
        tempControlGroup1,
        tempControlGroup2,
        tempControlGroup3,
        tempControlGroup4,
        tempSupplyEvap5,
        tempReturnEvap5,
        tempDeltaEvap5,
        tempSupplyEvap6,
        tempReturnEvap6,
        tempDeltaEvap6,
        tempSupplyEvap7,
        tempReturnEvap7,
        tempDeltaEvap7,
        tempSupplyEvap8,
        tempReturnEvap8,
        tempDeltaEvap8
    }
    STATUS current
    DESCRIPTION
        "Semantic thermal and HVAC process temperature metrics."
    ::= { brightCv3Groups 2 }

brightCv3HvacGroupGroup OBJECT-GROUP
    OBJECTS {
        hvacGroupIndex,
